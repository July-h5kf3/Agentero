{
	"name": "motif",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"lint": "pnpm run lint:ts && pnpm run lint:rs",
		"lint:ts": "biome check .",
		"lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
		"format": "pnpm run format:ts && pnpm run format:rs",
		"format:ts": "biome format --write .",
		"format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
		"fix": "pnpm run fix:ts && pnpm run fix:rs",
		"fix:ts": "biome check --write .",
		"fix:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml && pnpm run lint:rs",
		"prepare": "husky"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.2.9",
		"@tailwindcss/vite": "^4.3.2",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-shell": "^2.3.5",
		"@tauri-apps/plugin-store": "^2.4.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.23.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.6.2",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"shadcn": "^4.13.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@tauri-apps/cli": "^2",
		"@types/node": "^26.1.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"typescript": "~5.8.3",
		"vite": "^7.0.4"
	}
}
